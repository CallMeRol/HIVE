{
  "name": "hive",
  "private": true,
  "description": "Hive — BYOA 局域网群聊 MVP（vendored teahouse 底座，见 docs/vendor/teahouse.md）",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "setup": "npm ci --prefix vendor/teahouse",
    "setup:vendor-install": "npm install --prefix vendor/teahouse --no-audit --no-fund",
    "build": "npm run build --prefix vendor/teahouse",
    "typecheck": "npm run typecheck --prefix vendor/teahouse",
    "test:vendored": "npm test --prefix vendor/teahouse",
    "check:vendor": "node scripts/check-vendor-patches.mjs",
    "gen:vendor-baseline": "node scripts/gen-vendor-baseline.mjs",
    "test:guard": "node --test scripts/check-vendor-patches.test.mjs",
    "test:acp": "node scripts/acp-smoke.mjs",
    "e2e": "node scripts/hive-e2e.mjs",
    "e2e:app": "node scripts/hive-e2e.mjs --app vendor/teahouse/release/mac-arm64/Hive.app",
    "e2e:multigroup": "node scripts/hive-multigroup-e2e.mjs",
    "e2e:multigroup:app": "node scripts/hive-multigroup-e2e.mjs --app vendor/teahouse/release/mac-arm64/Hive.app",
    "e2e:member": "node scripts/hive-member-e2e.mjs",
    "e2e:member:app": "node scripts/hive-member-e2e.mjs --app vendor/teahouse/release/mac-arm64/Hive.app",
    "e2e:dispatch": "node scripts/hive-dispatch-e2e.mjs",
    "e2e:dispatch:app": "node scripts/hive-dispatch-e2e.mjs --app vendor/teahouse/release/mac-arm64/Hive.app",
    "e2e:dispatch56": "node scripts/hive-dispatch-e2e56.mjs",
    "e2e:dispatch56:app": "node scripts/hive-dispatch-e2e56.mjs --app vendor/teahouse/release/mac-arm64/Hive.app",
    "e2e:status": "node scripts/hive-status-e2e.mjs",
    "e2e:pending": "node scripts/hive-pending-e2e.mjs",
    "e2e:hangar": "node scripts/hive-hangar-e2e.mjs",
    "e2e:hangar:app": "node scripts/hive-hangar-e2e.mjs --app vendor/teahouse/release/mac-arm64/Teahouse.app",
    "hive": "node scripts/hive.mjs",
    "e2e:ops": "node scripts/hive-ops-e2e.mjs",
    "e2e:attach": "node scripts/hive-attach-e2e.mjs",
    "e2e:asar": "node scripts/hive-asar-e2e.mjs",
    "e2e:asar:app": "node scripts/hive-asar-e2e.mjs --app vendor/teahouse/release/mac-arm64/Hive.app",
    "e2e:recovery": "node scripts/hive-recovery-e2e.mjs",
    "e2e:recovery:app": "node scripts/hive-recovery-e2e.mjs --app vendor/teahouse/release/mac-arm64/Hive.app",
    "snapshot": "node scripts/hive-snapshot.mjs",
    "snapshot:dark": "node scripts/hive-snapshot.mjs --setup-done --dark --name hive-main-dark",
    "snapshot:app": "node scripts/hive-snapshot.mjs --app vendor/teahouse/release/mac-arm64/Hive.app --setup-done --dark --name hive-packaged-dark",
    "test": "npm run check:vendor && npm run test:guard && npm run test:vendored"
  }
}
